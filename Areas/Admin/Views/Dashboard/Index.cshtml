@model DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
}

<h2 class="fw-bold mb-4">📊 Tổng quan</h2>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Sản phẩm</div>
                <div class="fs-3 fw-bold">@Model.ProductCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Danh mục</div>
                <div class="fs-3 fw-bold">@Model.CategoryCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="text-decoration-none text-reset" asp-controller="Orders" asp-action="Index">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Đơn hàng</div>
                    <div class="fs-3 fw-bold">@Model.OrderCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Khách hàng</div>
                <div class="fs-3 fw-bold">@Model.CustomerCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <div class="text-muted small">Tổng doanh thu (không tính đơn đã huỷ)</div>
            <div class="fs-3 fw-bold text-danger">@Model.TotalRevenue.ToString("N0") đ</div>
        </div>
        <div class="text-muted small text-end">
            <a asp-controller="Statistics" asp-action="Index">Xem biểu đồ thống kê →</a>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-bold">5 đơn hàng mới nhất</div>
    @if (Model.LatestOrders.Count == 0)
    {
        <div class="card-body text-muted">Chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.LatestOrders)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">@order.OrderCode</a>
                            </td>
                            <td>@order.User?.FullName</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@order.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge @order.Status.ToBadgeClass()">@order.Status.ToVietnamese()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
